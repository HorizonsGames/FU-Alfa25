# Copy to .env for local development. On Heroku, set these as config vars instead
# (heroku config:set KEY=value) — DATABASE_URL is set automatically by the
# Heroku Postgres addon, you don't need to set it yourself.

# Provided automatically by `heroku addons:create heroku-postgresql:essential-0`
DATABASE_URL=postgres://localhost:5432/fractured_universe

# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API / open WebSockets.
# Set this to your game's real URL(s) once it's hosted — do not leave it as *
# in production, since that would let any website make authenticated requests
# on a logged-in player's behalf.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local port (Heroku sets PORT itself — this is only used when running locally)
PORT=3000
